# ==============================================================================
# HackTrack Backend Environment Configuration
# Copy this file to .env and configure your local MySQL credentials.
# IMPORTANT: Never commit .env with real credentials to source control.
# ==============================================================================

# Server Network Settings
PORT=5050
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5174

# Authentication: REQUIRED in production (>= 32 random characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Without it, development uses a random per-process key (sessions reset on restart).
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h
# Set to "1" when running behind one reverse proxy so client addresses are correct
# TRUST_PROXY=

# MySQL Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=hacktrack_db
DB_CONNECTION_LIMIT=10

# Optional: Set this if your local MySQL uses a Unix domain socket
# DB_SOCKET_PATH=/tmp/mysql.sock

# ==============================================================================
# Email notifications (transactional email)
# Providers: resend (recommended) | sendgrid | console (dev: logs only) | disabled
# If EMAIL_PROVIDER is unset: "resend" when EMAIL_API_KEY is set, otherwise "console".
# Never commit a real API key. Keep secrets in .env / your deployment's secret store.
# ==============================================================================
EMAIL_PROVIDER=console
EMAIL_API_KEY=your_provider_api_key_here
# Must be an address on a domain you have verified with the provider
EMAIL_FROM="HackTrack <notifications@your-domain.com>"
# Optional
EMAIL_REPLY_TO=
# Public URL of the frontend (used for buttons/links inside emails)
FRONTEND_URL=http://localhost:5174
# Public URL of this API (used for one-click unsubscribe links)
API_PUBLIC_URL=http://localhost:5050
# Delivery tuning
EMAIL_MAX_ATTEMPTS=3
EMAIL_RATE_PER_SECOND=5
# Optional dedicated key for signing unsubscribe links (defaults to one derived from JWT_SECRET)
EMAIL_LINK_SECRET=

# ==============================================================================
# Platform traffic analytics (first-party, anonymous)
# ==============================================================================
# Set to false to stop recording page views
ANALYTICS_ENABLED=true
# Key for hashing anonymous visitor/session ids (defaults to JWT_SECRET)
ANALYTICS_SECRET=
# How long page-view records are kept (days, minimum 30)
ANALYTICS_RETENTION_DAYS=395
# Per-client ingestion limit
ANALYTICS_RATE_PER_MINUTE=60

# Shared demo scenario. Stage it is built to when created from scratch
# (setup, registered, team, submitted, shortlisted, judged, published). Default: team
DEMO_START_STAGE=team
